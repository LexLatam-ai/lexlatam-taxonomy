{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LexLatam-ai/lexlatam-taxonomy/blob/main/data/schema.json",
  "title": "LexLatam Gaceta Oficial document taxonomy",
  "description": "Schema for data/document-types.json — the single source of truth.",
  "type": "object",
  "required": ["version", "types", "subtypes", "mappings", "fallbacks"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Semantic version of the taxonomy data.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "types": {
      "type": "object",
      "description": "Canonical document types keyed by canonical identifier.",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["label_es", "label_en"],
        "additionalProperties": false,
        "properties": {
          "label_es": { "type": "string", "minLength": 1 },
          "label_en": { "type": "string", "minLength": 1 }
        }
      }
    },
    "subtypes": {
      "type": "object",
      "description": "Canonical document subtypes keyed by canonical identifier.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["parent", "label_es", "label_en"],
        "additionalProperties": false,
        "properties": {
          "parent": {
            "type": "string",
            "description": "Canonical identifier of the parent type."
          },
          "label_es": { "type": "string", "minLength": 1 },
          "label_en": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mappings": {
      "type": "object",
      "description": "Exact native Gaceta strings mapped to canonical type/subtype.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["type", "subtype"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" },
          "subtype": { "type": ["string", "null"] }
        }
      }
    },
    "fallbacks": {
      "type": "array",
      "description": "Ordered prefix fallbacks applied when no exact mapping matches.",
      "items": {
        "type": "object",
        "required": ["prefix", "type", "subtype"],
        "additionalProperties": false,
        "properties": {
          "prefix": { "type": "string", "minLength": 1 },
          "type": { "type": "string" },
          "subtype": { "type": ["string", "null"] }
        }
      }
    }
  }
}
