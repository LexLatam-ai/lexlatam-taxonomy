{
  "name": "@lexlatam-ai/taxonomy",
  "version": "1.1.0",
  "description": "Language-neutral taxonomy for Gaceta Oficial de Panamá legal documents.",
  "author": "Invariant Engineering LLC <contact@invariantengineering.com>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LexLatam-ai/lexlatam-taxonomy.git",
    "directory": "typescript"
  },
  "type": "module",
  "packageManager": "pnpm@9.14.4",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src/data.json"],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
